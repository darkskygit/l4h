#!/bin/sh
# dom0 init for tests/run-captest.sh: run a fork-, signal- and thread-heavy
# guest under a CPU cap set right after it starts, check it never crashes.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /tmp
fail() { echo "CAPTEST: FAIL: $*"; poweroff -f; }
cap=$(sed -n 's/.*captest_cap=\([0-9]*\).*/\1/p' /proc/cmdline)
rounds=$(sed -n 's/.*captest_rounds=\([0-9]*\).*/\1/p' /proc/cmdline)
id=$(l4hctl create capvm --kernel /bin/vmlinux --initrd /bin/capvm.cpio.gz --mem 256 \
    --cmdline "console=hvc0 quiet caprounds=${rounds:-2}") || fail "create"
l4hctl sched "$id" "${cap:-25}" || fail "sched"
echo "CAPTEST: guest $id capped at ${cap:-25}%"
# Poll the console until the guest finishes, crashes or times out.
ok=0
t=0
while [ "$t" -lt 800 ]; do
    l4hctl console "$id" >/tmp/con.log
    grep -q "CAPVM: done" /tmp/con.log && { ok=1; break; }
    grep -qE "Kernel panic|Illegal|Segmentation|FAIL" /tmp/con.log && break
    sleep 2
    t=$((t + 2))
done
grep -E "CAPVM|SELFTEST|FAIL|Illegal|Segmentation|Caught|panic|BUG|Oops" /tmp/con.log | sed 's/^/CAPTEST: guest: /'
grep -qE "Illegal|Segmentation|Kernel panic|BUG|Oops" /tmp/con.log && fail "guest crashed"
grep -q "FAIL" /tmp/con.log && fail "guest self-test failed"
[ "$ok" = 1 ] || fail "guest did not finish"
grep -q "CAPVM: done fails=0" /tmp/con.log || fail "guest reported failures"
l4hctl destroy "$id"
echo "CAPTEST: PASS"
poweroff -f
