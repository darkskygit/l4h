#!/bin/sh
# dom0 init for tests/run-m6test.sh.  First boot: start a busy guest and
# reboot dom0.  Second boot (the guest is still there): check it survived,
# then cap its CPU use.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
fail() { echo "M6TEST: FAIL: $*"; poweroff -f; }
cpu1() { l4hctl top | awk -v n="$1" '$2 == n { split($3, a, "."); print a[1] }'; }
# Median of 9 samples of 100 ms: on a busy host the root task runs late, and
# a sample can count CPU time from earlier periods.
cpu() {
    for i in 1 2 3 4 5 6 7 8 9; do cpu1 "$1"; sleep 0.2; done | sort -n | sed -n 5p
}
if ! l4hctl list | grep -q " hog "; then
    id=$(l4hctl create hog --kernel /bin/vmlinux --initrd /bin/densvm.cpio.gz --mem 128 \
        --cmdline "console=hvc0 quiet HOG=1") || fail "create"
    l4hctl console "$id" --until "DENSVM: ready" --timeout 60 >/dev/null || fail "guest boot"
    echo "M6TEST: rebooting dom0"
    reboot -f
fi
echo "M6TEST: dom0 restarted"
l4hctl list
id=$(l4hctl list | awk '$2 == "hog" { print $1 }')
l4hctl send "$id" --wait "DENSVM: pong alive" alive >/dev/null || fail "guest lost across dom0 restart"
echo "M6TEST: guest $id survived"
sleep 2
before=$(cpu hog)
echo "M6TEST: uncapped: ${before}%"
[ "$before" -ge 80 ] || fail "busy guest uses only ${before}%"
l4hctl sched "$id" 25 || fail "sched"
steal() { l4hctl send "$id" --wait "DENSVM: stat" stat >/dev/null; l4hctl console "$id" | grep "DENSVM: stat" | tail -1 | awk '{ print $11 }'; }
s0=$(steal)
sleep 2
after=$(cpu hog)
s1=$(steal)
echo "M6TEST: guest steal ticks while capped: $((s1 - s0)) in 2 s"
[ $((s1 - s0)) -ge 80 ] || fail "steal time not reported ($s0 -> $s1)"
echo "M6TEST: capped at 25%: ${after}%"
[ "$after" -ge 15 ] && [ "$after" -le 35 ] || fail "cap not applied (${after}%)"
l4hctl sched "$id" 0
sleep 2
echo "M6TEST: uncapped again: $(cpu hog)%"
l4hctl destroy "$id"
echo "M6TEST: PASS"
poweroff -f
