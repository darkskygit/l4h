index e1b4830ac..64f3de48f 100644
--- a/include/model/statedata.h
+++ b/include/model/statedata.h
@@ -65,6 +65,7 @@ NODE_STATE_DECLARE(tcb_t, *ksSchedulerAction);
 
 #ifdef CONFIG_KERNEL_MCS
 NODE_STATE_DECLARE(tcb_queue_t, ksReleaseQueue);
+NODE_STATE_DECLARE(tcb_t *, ksTimerQueue);
 NODE_STATE_DECLARE(ticks_t, ksConsumed);
 NODE_STATE_DECLARE(ticks_t, ksCurTime);
 NODE_STATE_DECLARE(bool_t, ksReprogram);
diff --git a/include/object/structures.h b/include/object/structures.h
index 340f24e60..5023c7031 100644
--- a/include/object/structures.h
+++ b/include/object/structures.h
@@ -274,6 +274,15 @@ struct tcb {
 
     /* scheduling context that this tcb yielded to */
     sched_context_t *tcbYieldTo;
+
+    /* Deadline timer (seL4_TCB_SetTimer): absolute deadline in timer ticks,
+     * or 0 if disarmed; the badge signalled to the bound notification; the
+     * core whose timer queue holds the TCB; and the queue links. */
+    ticks_t tcbTimerDeadline;
+    word_t tcbTimerBadge;
+    word_t tcbTimerCore;
+    struct tcb *tcbTimerNext;
+    struct tcb *tcbTimerPrev;
 #else
     /* Timeslice remaining, 1 word */
     word_t tcbTimeSlice;
diff --git a/libsel4/include/interfaces/object-api.xml b/libsel4/include/interfaces/object-api.xml
index 1f433596e..705c27010 100644
--- a/libsel4/include/interfaces/object-api.xml
+++ b/libsel4/include/interfaces/object-api.xml
@@ -916,6 +916,27 @@
                 </description>
             </error>
         </method>
+        <method id="TCBSetTimer" name="SetTimer" manual_name="Set Deadline Timer" manual_label="tcb_settimer">
+            <condition><config var="CONFIG_KERNEL_MCS"/></condition>
+            <brief>
+                Arm or disarm a one-shot deadline timer that signals the TCB's bound notification.
+            </brief>
+            <description>
+                When the kernel's timer reaches <texttt text="deadline"/> the given badge is signalled
+                to the notification bound to the target TCB (if any) and the timer is disarmed. The
+                deadline is absolute and expressed in the kernel timer's ticks, which on x86 is the
+                TSC and on Arm the generic timer counter, so it can be computed from a user-level
+                read of the same counter. Re-arming replaces any previous deadline; a deadline of
+                zero disarms the timer. Only available on MCS kernels.
+            </description>
+            <param dir="in" name="deadline" type="seL4_Uint64" description="Absolute deadline in timer ticks, or 0 to disarm."/>
+            <param dir="in" name="badge" type="seL4_Word" description="Badge to signal to the bound notification."/>
+            <error name="seL4_IllegalOperation">
+                <description>
+                    The <texttt text="_service"/> is a CPtr to a capability of the wrong type.
+                </description>
+            </error>
+        </method>
     </interface>
 
     <interface name="seL4_CNode" manual_name="CNode">
diff --git a/src/kernel/thread.c b/src/kernel/thread.c
index 581327f64..4435fff24 100644
--- a/src/kernel/thread.c
+++ b/src/kernel/thread.c
@@ -619,6 +619,11 @@ void setNextInterrupt(void)
         next_interrupt = MIN(rlq_head_refill.rTime, next_interrupt);
     }
 
+    tcb_t *timer_head = NODE_STATE(ksTimerQueue);
+    if (timer_head != NULL) {
+        next_interrupt = MIN(next_interrupt, MAX(timer_head->tcbTimerDeadline, NODE_STATE(ksCurTime)));
+    }
+
     /* We should never be attempting to schedule anything earlier than ksCurTime */
     assert(next_interrupt >= NODE_STATE(ksCurTime));
 
@@ -743,8 +748,71 @@ static void tcbReleaseDequeue(void)
     possibleSwitchTo(awakened);
 }
 
+void timerQueueRemove(tcb_t *tcb)
+{
+    if (tcb->tcbTimerDeadline == 0) {
+        return;
+    }
+    if (tcb->tcbTimerPrev) {
+        tcb->tcbTimerPrev->tcbTimerNext = tcb->tcbTimerNext;
+    } else {
+        NODE_STATE_ON_CORE(ksTimerQueue, tcb->tcbTimerCore) = tcb->tcbTimerNext;
+    }
+    if (tcb->tcbTimerNext) {
+        tcb->tcbTimerNext->tcbTimerPrev = tcb->tcbTimerPrev;
+    }
+    tcb->tcbTimerNext = NULL;
+    tcb->tcbTimerPrev = NULL;
+    tcb->tcbTimerDeadline = 0;
+}
+
+void timerQueueInsert(tcb_t *tcb, ticks_t deadline, word_t badge)
+{
+    timerQueueRemove(tcb);
+    if (deadline == 0) {
+        return;
+    }
+
+    tcb_t *prev = NULL;
+    tcb_t *next = NODE_STATE(ksTimerQueue);
+    while (next != NULL && next->tcbTimerDeadline <= deadline) {
+        prev = next;
+        next = next->tcbTimerNext;
+    }
+
+    tcb->tcbTimerDeadline = deadline;
+    tcb->tcbTimerBadge = badge;
+    tcb->tcbTimerCore = getCurrentCPUIndex();
+    tcb->tcbTimerPrev = prev;
+    tcb->tcbTimerNext = next;
+    if (prev) {
+        prev->tcbTimerNext = tcb;
+    } else {
+        NODE_STATE(ksTimerQueue) = tcb;
+        NODE_STATE(ksReprogram) = true;
+    }
+    if (next) {
+        next->tcbTimerPrev = tcb;
+    }
+}
+
+static void fireTimers(void)
+{
+    while (NODE_STATE(ksTimerQueue) != NULL &&
+           NODE_STATE(ksTimerQueue)->tcbTimerDeadline <= NODE_STATE(ksCurTime) + getTimerPrecision()) {
+        tcb_t *tcb = NODE_STATE(ksTimerQueue);
+        word_t badge = tcb->tcbTimerBadge;
+        timerQueueRemove(tcb);
+        if (tcb->tcbBoundNotification) {
+            sendSignal(tcb->tcbBoundNotification, badge);
+        }
+        NODE_STATE(ksReprogram) = true;
+    }
+}
+
 void awaken(void)
 {
+    fireTimers();
     while (unlikely(release_q_non_empty_and_ready())) {
         tcbReleaseDequeue();
     }
