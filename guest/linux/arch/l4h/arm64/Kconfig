config UML_ARM64
	def_bool $(success,test "$(SUBARCH)" = "aarch64")

if UML_ARM64
config 64BIT
	def_bool y
config ARM64
	def_bool y
	select CLONE_BACKWARDS
	select GENERIC_CPU_AUTOPROBE
	select HAVE_EFFICIENT_UNALIGNED_ACCESS
	select HAVE_MOD_ARCH_SPECIFIC
	select MODULES_USE_ELF_RELA
config KERNEL_MODE_NEON
	def_bool y
	help
	  Kernel-mode NEON (kernel_neon_begin/end, arch/l4h/arm64/neon.c)
	  works in the guest kernel, so the arm64 crypto algorithms in
	  arch/arm64/crypto (ARMv8 Crypto Extensions AES and others) can be
	  selected.
config GENERIC_HWEIGHT
	def_bool y
config GENERIC_CSUM
	def_bool y
endif
