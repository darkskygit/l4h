diff --git a/src/object/tcb.c b/src/object/tcb.c
index dde25aee9..6bb2503e0 100644
--- a/src/object/tcb.c
+++ b/src/object/tcb.c
@@ -925,6 +925,25 @@ static exception_t decodeFPUTransfer(cap_t cap, word_t length, word_t *buffer, b
 }
 #endif /* CONFIG_HAVE_FPU */
 
+#ifdef CONFIG_KERNEL_MCS
+static exception_t decodeSetTimer(cap_t cap, word_t length, word_t *buffer)
+{
+    if (length < TIME_ARG_SIZE + 1) {
+        userError("TCB SetTimer: Truncated message.");
+        current_syscall_error.type = seL4_TruncatedMessage;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+
+    ticks_t deadline = mode_parseTimeArg(0, buffer);
+    word_t badge = getSyscallArg(TIME_ARG_SIZE, buffer);
+    tcb_t *thread = TCB_PTR(cap_thread_cap_get_capTCBPtr(cap));
+
+    setThreadState(NODE_STATE(ksCurThread), ThreadState_Restart);
+    timerQueueInsert(thread, deadline, badge);
+    return EXCEPTION_NONE;
+}
+#endif /* CONFIG_KERNEL_MCS */
+
 /* The following functions sit in the syscall error monad, but include the
  * exception cases for the preemptible bottom end, as they call the invoke
  * functions directly.  This is a significant deviation from the Haskell
@@ -1021,6 +1040,11 @@ exception_t decodeTCBInvocation(word_t invLabel, word_t length, cap_t cap,
     case TCBSetFlags:
         return decodeSetFlags(cap, length, call, buffer);
 
+#ifdef CONFIG_KERNEL_MCS
+    case TCBSetTimer:
+        return decodeSetTimer(cap, length, buffer);
+#endif
+
 #ifdef CONFIG_HAVE_FPU
     case TCBReadFPU:
         return decodeFPUTransfer(cap, length, buffer, true);
