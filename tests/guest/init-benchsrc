#!/bin/sh
# Sender guest of tests/guest/init-bench.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
ip link set lo up
ip addr add 192.168.9.3/24 dev eth0
ip link set eth0 up
ping -c 1 -W 5 192.168.9.2 >/dev/null
ping -c 20 -i 0.05 192.168.9.2 | sed -n 's/.*= \([0-9.]*\)\/\([0-9.]*\)\/.*/BENCH: guest-guest ping avg \2 ms/p'
s=$(cat /proc/uptime | cut -d' ' -f1)
dd if=/dev/zero bs=64k count=4096 2>/dev/null | nc 192.168.9.2 5001
e=$(cat /proc/uptime | cut -d' ' -f1)
echo "BENCH: guest-guest TCP 256 MiB in $s -> $e s" | awk '{ printf "BENCH: guest-guest TCP %.0f MB/s\n", 268.4 / ($9 - $7) }'
echo "BENCHSRC: done"
while true; do sleep 1000; done
