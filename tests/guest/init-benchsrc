#!/bin/sh
# Sender guest of tests/guest/init-bench.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
ip link set lo up
ip addr add 192.168.9.3/24 dev eth0
ip link set eth0 up
ping -c 1 -W 5 192.168.9.2 >/dev/null
ping -c 20 -i 0.05 192.168.9.2 | sed -n 's/.*= \([0-9.]*\)\/\([0-9.]*\)\/.*/BENCH: guest-guest ping avg \2 ms/p'
# CPU busy share of the sender (everything but idle, iowait and steal).
cpu() { awk '/^cpu / { print $2 + $3 + $4 + $7 + $8, $2 + $3 + $4 + $5 + $6 + $7 + $8 }' /proc/stat; }
c0=$(cpu)
s=$(cat /proc/uptime | cut -d' ' -f1)
netbench send 192.168.9.2 5001 256
e=$(cat /proc/uptime | cut -d' ' -f1)
c1=$(cpu)
echo "BENCH: guest-guest TCP 256 MiB in $s -> $e s" | awk '{ printf "BENCH: guest-guest TCP %.0f MB/s\n", 268.4 / ($9 - $7) }'
echo "$c0 $c1" | awk '$4 > $2 { printf "BENCH: guest-guest TCP sender busy %.0f %% CPU\n", 100 * ($3 - $1) / ($4 - $2) }'
echo "BENCHSRC: done"
while true; do sleep 1000; done
