#!/bin/sh
# Peer guest of tests/guest/init-bench: a TCP sink for the network test.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
ip link set lo up
ip addr add 192.168.9.2/24 dev eth0
ip link set eth0 up
echo "BENCHVM: ready"
while true; do nc -l -p 5001 > /dev/null; done
