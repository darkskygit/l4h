#!/bin/sh
# dom0 init for tests/run-uefitest.sh.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
echo "UEFITEST: dom0 up"
l4hctl info
l4hctl disks
l4hctl nics
ip link set lo up
ip link set eth0 up
if udhcpc -i eth0 -n -q -t 5 -s /bin/udhcpc.script >/dev/null 2>&1 && ping -c 2 -W 2 10.0.2.2 >/dev/null; then
    echo "UEFITEST: network ok"
fi
echo "UEFITEST: done"
poweroff -f
