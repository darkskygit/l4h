# The test guest for aarch64 (see main.c).
ROOT := $(abspath ../..)
SEL4 := $(ROOT)/build/sel4-aarch64/libsel4/include
OUT  := $(ROOT)/build/testguest-aarch64
CC   := aarch64-linux-gnu-gcc
LD   := aarch64-linux-gnu-ld
CFLAGS := -O2 -g -ffreestanding -fno-stack-protector -fno-pic -fno-pie -mgeneral-regs-only \
	  -ftls-model=local-exec -nostdinc -isystem $(shell $(CC) -print-file-name=include) \
	  -I$(SEL4) -I$(ROOT)/include -Wall -Wno-builtin-declaration-mismatch

$(OUT)/testguest.elf: main.c start-aarch64.S linker.ld
	mkdir -p $(OUT)
	$(CC) $(CFLAGS) -c main.c -o $(OUT)/main.o
	$(CC) $(CFLAGS) -c start-aarch64.S -o $(OUT)/start.o
	$(LD) -static -nostdlib -T linker.ld -z noexecstack -z max-page-size=4096 $(OUT)/start.o $(OUT)/main.o -o $@

clean:
	rm -rf $(OUT)
