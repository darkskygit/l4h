#!/bin/sh
# dom0 init for tests/run-attesttest.sh: print a report on dom0 and on a
# guest it starts, the host evidence, and (second boot) the secret of the
# credential in /bin/cred.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t configfs none /sys/kernel/config
nonce=$(sed -n 's/.*attest_nonce=\([0-9a-f]*\).*/\1/p' /proc/cmdline)
echo "ATTEST: dom0 up"
if l4hctl attest report "$nonce" -o /tmp/report; then
    echo "ATTEST: dom0 report $(l4hctl attest report "$nonce")"
    echo "ATTEST: evidence $(l4hctl attest evidence)"
fi
# configfs-tsm gives the same report (it is deterministic) and evidence.
r=/sys/kernel/config/tsm/report/r0
if mkdir $r 2>/dev/null; then
    echo "ATTEST: tsm provider $(cat $r/provider)"
    i=0 data=
    while [ $i -lt ${#nonce} ]; do
        data="$data\\x$(echo "$nonce" | cut -c$((i + 1))-$((i + 2)))"
        i=$((i + 2))
    done
    printf "$data" > $r/inblob
    cat $r/outblob > /tmp/tsm-report
    cmp -s /tmp/report /tmp/tsm-report && echo "ATTEST: tsm report matches"
    l4hctl attest evidence -o /tmp/evidence
    cat $r/auxblob | cmp -s /tmp/evidence - && echo "ATTEST: tsm evidence matches"
    rmdir $r
fi
if [ -f /bin/cred ]; then
    echo "ATTEST: secret $(l4hctl attest activate /bin/cred)"
fi
if [ -f /bin/vmlinux ]; then
    # Its console, printed once it is done: the host also copies it to the
    # serial port, and the two copies would interleave.
    id=$(l4hctl create attestvm --kernel /bin/vmlinux --initrd /bin/vm.cpio.gz --mem 64 \
        --cmdline "console=hvc0 attest_nonce=$nonce") && \
        l4hctl console "$id" --until "ATTESTVM: done" --timeout 60 > /tmp/vm.out
    sleep 1
    grep ATTESTVM /tmp/vm.out
fi
echo "ATTEST: done"
poweroff -f
