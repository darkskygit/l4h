From 4350ac6fc32b2f48e7903d8c9fc030a71a1542c6 Mon Sep 17 00:00:00 2001
From: l4h <l4h@localhost>
Date: Wed, 28 Oct 2026 07:57:50 -0700
Subject: [PATCH] aarch64: save TLS before taking the kernel lock

EL0 can write TPIDR_EL0 directly. Saving TLS in arch_c_entry_hook is too
late: a remote stall serviced while waiting for the BKL can switch to
idle and return to userspace without ever reaching that hook. The target
thread then keeps its old TLS value, including zero just after exec.

Save both TLS registers in kernel_enter alongside the general registers,
before any lock acquisition. Keep the C save hook only for AArch32.
The AArch64 idle IRQ entry needs no save: the idle thread is stateless.

A controlled first syscall with a newly written TPIDR_EL0 reproduces a
zero saved TLS value at c_handle_syscall on the previous kernel. With
this change the saved value matches before the lock can service IPIs.
---
 include/arch/arm/arch/64/mode/machine.h | 6 ------
 include/arch/arm/arch/kernel/traps.h    | 4 ++++
 src/arch/arm/64/traps.S                 | 7 +++++++
 3 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/include/arch/arm/arch/64/mode/machine.h b/include/arch/arm/arch/64/mode/machine.h
index e04c2ba9e..e99892a40 100644
--- a/include/arch/arm/arch/64/mode/machine.h
+++ b/include/arch/arm/arch/64/mode/machine.h
@@ -113,12 +113,6 @@ static inline word_t readTPIDR_EL1(void)
     return reg;
 }
 
-static void arm_save_thread_id(tcb_t *thread)
-{
-    setRegister(thread, TPIDR_EL0, readTPIDR_EL0());
-    setRegister(thread, TPIDRRO_EL0, readTPIDRRO_EL0());
-}
-
 static void arm_load_thread_id(tcb_t *thread)
 {
     writeTPIDR_EL0(getRegister(thread, TPIDR_EL0));
diff --git a/include/arch/arm/arch/kernel/traps.h b/include/arch/arm/arch/kernel/traps.h
index c32454273..5edaf0cfc 100644
--- a/include/arch/arm/arch/kernel/traps.h
+++ b/include/arch/arm/arch/kernel/traps.h
@@ -12,7 +12,11 @@
 
 static inline void arch_c_entry_hook(void)
 {
+#ifdef CONFIG_ARCH_AARCH32
     arm_save_thread_id(NODE_STATE(ksCurThread));
+#endif
+    /* AArch64 saves TLS with the rest of the user context in assembly,
+     * before a remote stall can interrupt kernel lock acquisition. */
 }
 
 static inline void arch_c_exit_hook(void)
diff --git a/src/arch/arm/64/traps.S b/src/arch/arm/64/traps.S
index cbdb93417..9c3a40ccd 100644
--- a/src/arch/arm/64/traps.S
+++ b/src/arch/arm/64/traps.S
@@ -120,6 +120,13 @@ END_FUNC(arm_vector_table)
     mrs     x23, SPSR
     stp     x30, x21, [sp, #PT_LR]
     stp     x22, x23, [sp, #PT_ELR_EL1]
+
+    /* Save TLS before acquiring the kernel lock. A remote stall can
+     * switch to idle and leave lock acquisition without reaching the
+     * C entry hook. In particular, EL0 can write TPIDR_EL0 directly. */
+    mrs     x21, tpidr_el0
+    mrs     x22, tpidrro_el0
+    stp     x21, x22, [sp, #PT_TPIDR_EL0]
 .endm
 
 /* Takes argument x0: vect_offset (in debug builds) */
-- 
