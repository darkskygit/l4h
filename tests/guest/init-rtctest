#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
fail() { echo "RTCTEST: FAIL: $*"; poweroff -f; }
before=$(date +%s)
[ "$before" -ge 1893456000 ] || fail "RTC boot seed"
# Give the test runner time to pause QEMU and choose the CMOS format
# after SeaBIOS has finished initializing it.
echo "RTCTEST: ready"
sleep 5
id=$(l4hctl create rtc-denied --initrd /bin/rtc-denied.cpio.gz --mem 128) || fail "create ordinary guest"
l4hctl console "$id" --until 'RTCDENIED: PASS' --timeout 120 || fail "ordinary guest RTC access"
l4hctl destroy "$id" || fail "destroy ordinary guest"
case "$L4H_RTC_TEST" in
    explicit)
        target=951827696 # 2000-02-29 12:34:56 UTC
        l4hctl rtc-set "$target" || fail "explicit time"
        ;;
    default)
        # First move the RTC away from Linux's clock, then copy the clock
        # back with the argument-free command.
        l4hctl rtc-set 951827696 || fail "preliminary time"
        target=$(date +%s)
        l4hctl rtc-set || fail "current time"
        ;;
    *) fail "test mode" ;;
esac
for seconds in "$L4H_RTC_INVALID" 18446744073709551615; do
    if l4hctl rtc-set "$seconds" >/tmp/err 2>&1; then fail "accepted $seconds"; fi
    grep -q 'invalid argument' /tmp/err || fail "range error"
done
after=$(date +%s)
[ "$after" -ge "$before" ] && [ "$after" -lt "$((before + 120))" ] || fail "guest clock changed"
echo "RTCTEST: PASS target=$target"
poweroff -f
