 include/model/statedata.h                 |  1 +
 include/object/structures.h               |  9 +++
 libsel4/include/interfaces/object-api.xml | 21 +++++++
 src/kernel/thread.c                       | 68 +++++++++++++++++++++++
 src/model/statedata.c                     |  2 +
 src/object/objecttype.c                   |  1 +
 src/object/tcb.c                          | 24 ++++++++
 8 files changed, 130 insertions(+)

diff --git a/include/kernel/thread.h b/include/kernel/thread.h
index 4a828f6bc..da4ce5bbc 100644
--- a/include/kernel/thread.h
+++ b/include/kernel/thread.h
@@ -307,6 +307,10 @@ void setNextInterrupt(void);
 
 /* Wake any periodic threads that are ready for budget recharge */
 void awaken(void);
+
+/* Deadline timers (seL4_TCB_SetTimer) */
+void timerQueueRemove(tcb_t *tcb);
+void timerQueueInsert(tcb_t *tcb, ticks_t deadline, word_t badge);
 /* Place the thread bound to this scheduling context in the release queue
  * of periodic threads waiting for budget recharge */
 void postpone(sched_context_t *sc);
