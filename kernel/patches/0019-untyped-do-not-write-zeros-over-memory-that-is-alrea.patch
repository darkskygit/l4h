From 64f6e90651472fe25644cda83fc2c8ed09628397 Mon Sep 17 00:00:00 2001
From: l4h <z@univalence.me>
Date: Mon, 19 Oct 2026 22:57:33 -0700
Subject: [PATCH] untyped: do not write zeros over memory that is already zero

Resetting an Untyped cleared all the memory it had handed out, writing
every byte.  Under a hypervisor that backs guest memory on demand, such
as QEMU/KVM, this backs memory the guest never used or gave back with
virtio-balloon free page reporting: boot Untypeds start with their free
index at the end, so the first retype of each clears all of it, and l4h
then occupies all of its RAM on the host from the start.

Read each page first (or each reset chunk, when smaller) and clear it
only if it holds a non-zero word.  Reading memory the host has not backed
maps its shared zero page instead.  The memory reads as zero afterwards
either way.

On Arm the reads go through the kernel window, which is cacheable, while
user level can have written the memory through a non-cacheable (Device)
mapping of its frame.  Such writes leave clean cached copies alone, so
the reads could see stale zeros over non-zero memory and skip the clear;
an object later made from the memory (a CNode, a page table, another
user's frame) would see the old contents once those lines are evicted.
The cached copies are written back and invalidated first, so that the
reads see the memory itself.  (Clearing unconditionally never had this
problem: its dirty zeros are the last write.)
---
 src/object/untyped.c | 35 +++++++++++++++++++++++++++++++++--
 1 file changed, 33 insertions(+), 2 deletions(-)

diff --git a/src/object/untyped.c b/src/object/untyped.c
index 7e1704ce4..c0350d5e9 100644
--- a/src/object/untyped.c
+++ b/src/object/untyped.c
@@ -231,6 +231,37 @@ exception_t decodeUntypedInvocation(word_t invLabel, word_t length, cte_t *slot,
                                 destCNode, nodeOffset, nodeWindow, deviceMemory);
 }
 
+/* Clear memory for reuse, writing only to the pages (or smaller chunks)
+ * that are not zero already.  Under a hypervisor, memory the guest never
+ * wrote or gave back (virtio-balloon free page reporting) reads as zero
+ * without being backed by host memory; writing zeros to it would back it
+ * again. */
+static void clearDirtyMemory(void *ptr, word_t bits)
+{
+    word_t step = BIT(MIN(bits, (word_t)seL4_PageBits));
+    word_t off;
+
+    for (off = 0; off < BIT(bits); off += step) {
+        word_t *p = (word_t *)((word_t)ptr + off);
+        word_t i;
+#ifdef CONFIG_ARCH_ARM
+        /* The reads go through the cacheable kernel window.  A write
+         * through a non-cacheable (Device) user mapping leaves clean
+         * cached copies alone, which would read as zero over non-zero
+         * memory: objects made from it would see its old contents once
+         * they are evicted.  Write back and drop the copies first. */
+        cleanInvalidateCacheRange_RAM((word_t)p, (word_t)p + step - 1,
+                                      addrFromPPtr(p));
+#endif
+        for (i = 0; i < step / sizeof(word_t); i++) {
+            if (p[i] != 0) {
+                memzero(p, step);
+                break;
+            }
+        }
+    }
+}
+
 static exception_t resetUntypedCap(cte_t *srcSlot)
 {
     cap_t prev_cap = srcSlot->cap;
@@ -252,13 +283,13 @@ static exception_t resetUntypedCap(cte_t *srcSlot)
 
     if (deviceMemory || block_size < chunk) {
         if (! deviceMemory) {
-            clearMemory(regionBase, block_size);
+            clearDirtyMemory(regionBase, block_size);
         }
         srcSlot->cap = cap_untyped_cap_set_capFreeIndex(prev_cap, 0);
     } else {
         for (offset = ROUND_DOWN(offset - 1, chunk);
              offset != - BIT(chunk); offset -= BIT(chunk)) {
-            clearMemory(GET_OFFSET_FREE_PTR(regionBase, offset), chunk);
+            clearDirtyMemory(GET_OFFSET_FREE_PTR(regionBase, offset), chunk);
             srcSlot->cap = cap_untyped_cap_set_capFreeIndex(prev_cap, OFFSET_TO_FREE_INDEX(offset));
             status = preemptionPoint();
             if (status != EXCEPTION_NONE) {
